# ViralGenix - Environment Variables Configuration

# Masukkan salah satu atau semua API key yang Anda miliki:

# 1. Google Gemini API (100% GRATIS 1.500 Request/Hari di https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq Cloud API (100% GRATIS & Super Cepat di https://console.groq.com/)
GROQ_API_KEY=

# 3. DeepSeek API (Super Hemat di https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# 4. Qwen / Alibaba DashScope API (https://dashscope.console.aliyun.com/)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 5. OpenAI API (GPT-4o di https://platform.openai.com/)
OPENAI_API_KEY=

# 6. Anthropic API (Claude 3.5 Sonnet di https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# 7. OpenRouter API (Universal Access di https://openrouter.ai/)
OPENROUTER_API_KEY=

# 8. Apify API (Opsional: https://apify.com/)
APIFY_API_TOKEN=
